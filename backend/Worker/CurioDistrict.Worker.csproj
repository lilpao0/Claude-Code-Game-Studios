<Project Sdk="Microsoft.NET.Sdk.Worker">

  <ItemGroup>
    <!-- ADR-0004: Worker depends inward upon Domain only. -->
    <ProjectReference Include="..\Domain\CurioDistrict.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Worker SDK does not pull the hosting abstractions implicitly. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CurioDistrict.Worker</RootNamespace>
  </PropertyGroup>

</Project>
